# ---------------------------------------------------------------------------
# shop desk — example configuration. Copy to .env and fill in real values.
# Nothing here is a real secret. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# runtime
NODE_ENV=development
PORT=3000
SHOPDESK_HOST=0.0.0.0
SHOPDESK_REGION=local

# storage: leave MONGODB_URI empty for the local single-writer file driver.
# Production target is Atlas with a replica set (transactions are required).
MONGODB_URI=
MONGODB_DB=shopdesk
SHOPDESK_DATA_DIR=./.data

# first-run setup. If empty, the server generates a token and writes it to
# $SHOPDESK_DATA_DIR/setup-token.txt (mode 0600) and prints it once.
SHOPDESK_SETUP_TOKEN=

# sessions / transport
SHOPDESK_SESSION_HOURS=12
SHOPDESK_SECURE_COOKIES=0
SHOPDESK_TRUST_PROXY=0

# operational batch endpoint (Vercel cron). Required; no browser session works.
SHOPDESK_CRON_SECRET=

# development conveniences — MUST stay off in production
SHOPDESK_DEV_EXPOSE_SETUP_TOKEN=0
SHOPDESK_DISABLE_TICKER=0
