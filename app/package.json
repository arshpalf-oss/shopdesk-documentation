{
  "name": "shopdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "shop desk — multi-tenant veterinary billing, inventory and double-entry accounting",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
