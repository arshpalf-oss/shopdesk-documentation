{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/[...path].js" }
  ],
  "crons": [
    { "path": "/api/v1/cron/jobs", "schedule": "*/5 * * * *" }
  ]
}
